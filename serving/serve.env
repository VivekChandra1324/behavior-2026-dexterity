# Serving environment for the production π0.5 checkpoint: every B1K_* variable that the openpi code reads when it
# BUILDS or RUNS the model, set exactly as in training (configs/train.env). Source it before serve_b1k.py.
# Training-only variables (data staging, loader, LR, logging) are left out on purpose.
export B1K_STAGE_AUX=1            # the checkpoint contains the stage head's params; without it the param tree differs
export B1K_NORM_STATE=q           # state: quantile normalization
export B1K_NORM_ACTIONS=z         # actions: z-score normalization
export B1K_QUANTILE_NORM=0        # the two per-key switches above decide
export B1K_CORRELATED_NOISE=0     # isotropic flow-matching noise (pi0.5 default), as trained
export B1K_NUM_FLOW_SAMPLES=15    # training loss only; set for an identical model object
export B1K_STAGE_LOSS_FIX=0       # training loss only; as trained
export B1K_FREEZE_VISION=0        # training only; as trained
