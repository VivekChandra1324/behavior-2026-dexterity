# Training configuration -- the exact settings of our final run (checkpoint 135199), annotated.
# scripts/train.sh and scripts/prepare_assets.sh source this file. Paths follow $WORK; edit the "your hardware" and
# "schedule" blocks for your GPUs (or copy this file and pass it with
#   TRAIN_ENV=my.env bash scripts/train.sh $WORK/openpi-b1k)
# How to size the hardware block for your GPUs: docs/TRAINING_GUIDE.md §5 ("Size the run for your GPUs").

# ---------------------------------------------------------------- paths
# Everything lives under one working directory, $WORK (export it before running any script; see README):
#   $WORK/data/2026-challenge-demos   downloaded dataset          $WORK/openpi-b1k    training code (setup_openpi.sh)
#   $WORK/data/2026-challenge-rgb224  224 training dataset        $WORK/assets        norm stats + stage table
#   $WORK/checkpoints                 checkpoints
: "${WORK:?set WORK to your working directory first, e.g. export WORK=/data/b1k (see README)}"
export B1K_DATASET_ROOT=$WORK/data/2026-challenge-rgb224      # the 224 training root (scripts/transcode_rgb224.py)
export B1K_REPO_ID=behavior-1k/2026-challenge-rgb224          # a name; assets are stored under <assets>/pi05_b1k/<repo_id>
export ASSETS_DIR=$WORK/assets                                # norm_stats.json + stage_table.json live here
export CKPT_DIR=$WORK/checkpoints                             # checkpoints: <CKPT_DIR>/pi05_b1k/<EXP_NAME>/<step>
export EXP_NAME=pi05-b1k
export OPENPI_DATA_HOME=${OPENPI_DATA_HOME:-$WORK/cache/openpi}   # pi0.5 base weights (~12 GB) are downloaded here

# ---------------------------------------------------------------- your hardware (edit these; see the guide)
# Ours: 2 nodes x 4 H100 80GB = 8 GPUs, global batch 832 (104 per GPU), FSDP inside each node.
export BATCH_SIZE=832          # GLOBAL batch. Must be divisible by the number of GPUs.
export FSDP_DEVICES=4          # shard parameters/optimizer over this many GPUs (<= GPUs per node; 1 = no sharding)
export NUM_WORKERS=16          # data-loader processes per node (16 was the measured optimum on 96 cores)
export B1K_DECODER_CACHE=16    # open video decoders kept per worker (64 x 24 workers once used 236 GiB of RAM)

# ---------------------------------------------------------------- schedule
export TOTAL_STEPS=135200      # 135,200 x 832 = 112.5 M samples, ~0.53 epochs of the 211 M frames
export WARMUP_STEPS=1000
export PEAK_LR=6.4e-5          # chosen by an LR sweep at batch 832; scale ~sqrt(batch) if you change the batch
export COOLDOWN_PCT=15         # warmup-stable-decay: constant LR, then linear decay over the last 15% of steps
export SAVE_INTERVAL=2500      # checkpoint every 2,500 steps (each checkpoint ~ 12 GB params + optimizer state)

# ---------------------------------------------------------------- model / objective
export B1K_NUM_FLOW_SAMPLES=15 # flow-matching noise samples per example (2025 winner's trick): -8.3% held-out action error
export B1K_STAGE_AUX=1         # auxiliary head predicting the temporal stage of the task (needs stage_table.json)
export B1K_STAGE_LOSS_FIX=0    # keep the original small weight of that auxiliary loss (a larger one measured 2% worse)
export B1K_FREEZE_VISION=0     # train the SigLIP vision tower (freezing was +17% faster but 4% worse on held-out error)
export B1K_CORRELATED_NOISE=0  # isotropic flow-matching noise, the pi0.5 default (correlated noise measured worse)

# ---------------------------------------------------------------- normalisation
export B1K_QUANTILE_NORM=0     # leave 0; the two per-key switches below decide
export B1K_NORM_STATE=q        # state: quantile normalisation (z-score saturated 28.6% of state values; q: 5.0%)
export B1K_NORM_ACTIONS=z      # actions: z-score

# ---------------------------------------------------------------- data sampling and loader
export B1K_TASK_ALPHA=0.5      # sample a task with probability ~ (its frame count)^0.5: long tasks not over-sampled
export B1K_LOADER_IN_ORDER=0   # hand batches over as they complete (one slow read no longer stalls the step)
